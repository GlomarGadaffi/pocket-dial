*.sh text eol=lf

# Hooks are invoked directly by git's own shell (via the shebang), no
# extension to match on -- pin LF explicitly or a CRLF checkout on Windows
# breaks the #! line and the hook silently never runs.
.githooks/* text eol=lf

# Generated by re2c and committed (issue #196). CI regenerates and diffs to
# catch drift, which only works if the checked-out bytes are identical on
# every platform -- re2c emits LF, so with the repo's usual CRLF checkout a
# developer on Windows sees the ENTIRE file as changed and the check reads
# as broken rather than as drift. Pin both the generator input and its
# output to LF so regeneration round-trips anywhere.
src/SIP/Sdp.re text eol=lf
src/SIP/Sdp.cpp text eol=lf

install.sh export-ignore
install.ps1 export-ignore
README.md export-ignore
.gitattributes export-ignore
docs/ export-ignore
