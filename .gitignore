# Build output, managed deps, and scratch (added 2026-06-03)
# build_*/ catches any alternate/side-by-side build dir (build_desktop, build_v5_eth, ...)
build_*/
# build-wsl/: the WSL host-test build dir (hyphen, not underscore — build_*/ above
# does not match it). Without this, `git stash -u` sweeps its generated CMake/gtest
# content into the stash as "untracked".
build-wsl/
# build-waveshare/: same hyphenated-name gap as build-wsl/ above, for the
# Waveshare board build dir — without this, `git add -A` sweeps a large
# untracked firmware build directory into the index.
build-waveshare/
managed_components/
dependencies.lock
scratch/
serial_log.txt
post_issue_comments.ps1

# Code-review fixes session scratch (added 2026-06-08)
build_*.log
.claude/
# Smoke-test tooling: keep the reusable scripts, ignore generated images/logs
.smoke/*
!.smoke/*.py

# Session build/verify iteration scratch logs (added 2026-06-09)
b[0-9]*.log
verify_*.log
host_test*.log
export_output.log

# Shareable binary packages (built locally from build_host_ssh; never commit binaries)
dist/

# Local scratch and rename-history artefacts
notes/
LINEAGE.md
*.old
*.bak

# Interop harness (tests/interop): server + per-UA SIP traces, regenerated each run
tests/interop/.logs/
tests/sipp/.logs/
tests/.results/
__pycache__/
*.pyc

# Host-build runtime state. These are the desktop stand-ins for the NVS
# namespaces the firmware uses, written into the CWD the moment SipServer runs.
# pocketdial_tapi.cfg holds the carrier OAuth client_id/client_secret (the s*id /
# s*sec keys), so this is a credential-leak guard, not just tidiness.
# Wildcard rather than the two current names (pocketdial_tapi.cfg,
# pocketdial_didmap.cfg) so a future host-backed namespace is covered on day one.
pocketdial_*.cfg

# Written by tests/DialPlan_test.cpp into the CWD, one per test case. Build
# artifacts, not fixtures. Ignored for the same reason as the line above and
# then some: they use the TAPI config FORMAT, whose s*id / s*sec fields hold
# carrier OAuth credentials. The ones the suite currently writes are empty,
# but a committed file of that shape is one populated test run away from
# being a real leak.
test_dialplan_tapicfg_*.cfg
