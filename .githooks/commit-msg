#!/bin/sh
# Reject a commit outright if its message carries a Claude-Session: trailer
# or the noreply attribution address -- pocket-dial's convention forbids both
# (see CONTRIBUTING_FIRMWARE.md, issues #326 and #1106). Commits end with the
# single line --superlite and no other attribution trailer.
#
# Not installed by default -- git only runs hooks from .git/hooks, so this
# has no effect until each clone opts in once with:
#   git config core.hooksPath .githooks
#
# Same opt-in as .githooks/post-checkout; enabling one enables both, and
# core.hooksPath is repo-level config -- one opt-in in the shared clone
# protects every linked worktree under it at once, not just that one clone.
#
# Unlike post-checkout, this one CAN actually block: commit-msg fires after
# the message is composed but before the commit object is created, and a
# nonzero exit here aborts the commit. (`git commit --no-verify` skips every
# hook by design -- an intentional, git-level escape hatch, not a gap in
# this check.)
#
# Written the same night #326's CI-side guard was, and deliberately checks
# the SAME pattern the same way: full message body via grep -n
# '^Claude-Session:', not just the subject line. #326's own self-test found
# a squash-merge commit on main whose subject was clean but whose body
# carried the trailer 50-odd lines down, inherited from a squashed
# sub-commit. A check that only looked at the first line would have missed
# exactly that shape.

# Both patterns (Claude-Session trailer, noreply attribution address) live in
# tools/ci/commit_hygiene.sh, the same script CI calls, so the two can never
# disagree (issues #341, #1106).
LIB="$(dirname "$0")/../tools/ci/commit_hygiene.sh"
if [ ! -f "$LIB" ]; then
    # Fail closed: a missing pattern file must not turn into "nothing to check".
    echo "commit-msg: $LIB missing; refusing to pass unchecked" >&2
    exit 1
fi

# check_message TEXT KIND: returns 0 if TEXT carries KIND (trailer|address),
# 1 if clean. Any other checker status (rc 2 = checker error) fails closed:
# the commit is rejected, never passed.
check_message() {
    printf '%s\n' "$1" | sh "$LIB" match "$2"
    cmrc=$?
    case "$cmrc" in
        0|1) return "$cmrc" ;;
    esac
    echo "commit-msg: checker failed (rc ${cmrc}); rejecting rather than passing unchecked" >&2
    exit 1
}

if [ "$1" = "--selftest" ]; then
    bad="fix: something

Co-authored-by: Claude Sonnet 5 <bot@example.invalid>
Claude-Session: https://claude.ai/code/session_selftest"
    bad_lower="fix: something

claude-session: https://claude.ai/code/session_selftest"
    bad_reflowed="fix: something

Co-authored-by: Claude Sonnet 5 <bot@example.invalid> Claude-Session: https://claude.ai/code/session_selftest"
    good="fix: something

Co-authored-by: Claude Sonnet 5 <bot@example.invalid>"
    good_prose="docs: the Claude-Session trailer stays forbidden (see #326)"

    for name in bad bad_lower bad_reflowed; do
        eval "msg=\$$name"
        if check_message "$msg" trailer; then
            echo "selftest: correctly detects a trailer ($name)"
        else
            echo "FAIL: did not detect a known-bad message ($name)"
            exit 1
        fi
    done

    for name in good good_prose; do
        eval "msg=\$$name"
        if check_message "$msg" trailer; then
            echo "FAIL: false positive on a known-good message ($name)"
            exit 1
        else
            echo "selftest: correctly passes a clean message ($name)"
        fi
    done

    # The attribution address, built from pieces so this file never holds it.
    au="noreply"; ah="anthropic"
    addr="${au}@${ah}.com"
    addr_up="$(printf '%s' "$addr" | tr 'a-z' 'A-Z')"
    addr_trailer="fix: something

Co-Authored-By: Bot <${addr}>"
    addr_upper="fix: something

Co-Authored-By: Bot <${addr_up}>"
    addr_body="fix: something

prose naming ${addr} in the body"
    addr_ok="fix: something

Co-authored-by: Someone <12345+someone@users.${au}.github.com>"

    for name in addr_trailer addr_upper addr_body; do
        eval "msg=\$$name"
        if check_message "$msg" address; then
            echo "selftest: correctly detects the address ($name)"
        else
            echo "FAIL: did not detect the address ($name)"
            exit 1
        fi
    done

    if check_message "$addr_ok" address; then
        echo "FAIL: false positive on a users.noreply.github.com address"
        exit 1
    fi
    echo "selftest: correctly passes a users.noreply.github.com address"

    exit 0
fi

MSG_FILE="$1"

if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    # git ALWAYS passes a real message-file path here -- that is the
    # commit-msg hook contract, not something to defend against. If this
    # branch is reached at all, something ran this script directly with a
    # missing or bad argument (not via git, and not --selftest, which is
    # handled above). That is misuse, not a legitimate case to fail open
    # on -- a check whose own error path silently does nothing is exactly
    # the failure shape this whole effort exists to stop shipping.
    echo "usage: commit-msg <message-file> | --selftest" >&2
    exit 1
fi

MSG_BODY="$(cat "$MSG_FILE")"

reject() {
    echo "" >&2
    echo "############################################################" >&2
    echo "#  REJECTED: this commit message carries $1" >&2
    echo "#  pocket-dial's convention forbids it (see                  " >&2
    echo "#  CONTRIBUTING_FIRMWARE.md, issues #326 and #1106).         " >&2
    echo "#                                                            " >&2
    echo "#  Remove it. Commits end with --superlite only. If your     " >&2
    echo "#  harness auto-appends it, strip it before committing       " >&2
    echo "#  rather than after.                                        " >&2
    echo "############################################################" >&2
    echo "" >&2
    exit 1
}

if check_message "$MSG_BODY" trailer; then
    reject "a Claude-Session: trailer."
fi
if check_message "$MSG_BODY" address; then
    reject "the noreply attribution address."
fi

exit 0
